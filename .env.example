# Eggbot environment variables
# Copy to .env and fill in values

# REQUIRED: Bot's secret key (nsec format)
# Generate with: nak key generate | nak encode nsec
EGGBOT_NSEC=nsec1...

# OPTIONAL: NWC connection string for invoice creation via Nostr Wallet Connect
# Get from your wallet (e.g., Alby Hub) under app connections
# EGGBOT_NWC=nostr+walletconnect://WALLET_PUBKEY?relay=wss://relay.example.com&secret=APP_SECRET

# OPTIONAL: Override config file settings
# EGGBOT_DATABASE_PATH=eggbot.db
# EGGBOT_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# EGGBOT_PRICING_SATS_PER_HALF_DOZEN=3200
